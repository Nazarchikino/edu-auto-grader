# Production environment configuration for docker-compose.prod.yml
# Copy this file to .env.production and replace every placeholder with strong secrets.
# Generate a strong JWT secret with: openssl rand -hex 32

# Public HTTP port exposed by Nginx frontend container
APP_HTTP_PORT=8080

# PostgreSQL 16 credentials (required — no insecure defaults)
POSTGRES_USER=edu_grader
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=edu_auto_grader

# JWT signing secret (required in APP_ENV=production, >= 32 characters)
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY

# Allowed frontend origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:8080"]

# Submission file retention policy
SUBMISSION_FILE_RETENTION_DAYS=90
SUBMISSION_SUPERSEDED_GRACE_HOURS=24
ENABLE_RETENTION_CLEANUP_TASK=true

# Admission quiz security policy
QUIZ_PASS_THRESHOLD_PERCENT=70.0
QUIZ_RETRY_COOLDOWN_SECONDS=300

# Backup retention (used by scripts/backup.sh)
RETENTION_BACKUP_DAYS=14
